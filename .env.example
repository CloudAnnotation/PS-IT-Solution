# Public site URL, used for canonical URLs, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form delivery (optional) -------------------------------------
# Without these three values the contact form validates input and tells the
# visitor plainly that the message could not be sent. Nothing is stored.
# With them, inquiries are emailed through Resend (https://resend.com).
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=
# Where inquiries are delivered.
CONTACT_TO_EMAIL=
